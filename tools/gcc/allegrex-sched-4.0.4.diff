Instruction latencies of the game's retail compiler (notes/COMPILER.md, "Scheduling
latencies"), for the build psp-gcc-4.0.4a: the LBP-PSP-Decomp kit's psp-gcc-4.0.4c
work tree plus this diff and block-move-4.0.4.diff (tools/gcc/build_404a.sh). Applies
with `patch -p1` in gcc-4.0.4/ after the kit's diffs.
In config/mips/allegrex-sched.md, the kit's Allegrex scheduling description, six
instruction types get their own latency instead of generic.md's: float conversions,
moves, comparisons and single-precision multiplications 4 (like generic.md's
additions), mfc1/mtc1 3, integer multiplications 5. Each value is the one that gives
the most functions of the game's Bullet library byte for byte, with none lost.
The kit's context is GPL-3.0-or-later.
--- a/gcc/config/mips/allegrex-sched.md
+++ b/gcc/config/mips/allegrex-sched.md
@@ -7,3 +7,29 @@
 (define_insn_reservation "alg_store" 1
   (and (eq_attr "cpu" "allegrex") (eq_attr "type" "store,fpstore,fpidxstore"))
   "alu+alg_mem,alg_mem*2")
+;; game: latencies of the retail compiler where they differ from generic.md
+;; float conversions (trunc.w.s, cvt.s.w...): generic 1
+(define_insn_reservation "alg_fcvt" 4
+  (and (eq_attr "cpu" "allegrex") (eq_attr "type" "fcvt"))
+  "alu")
+;; mov.s, abs.s, neg.s: generic 2
+(define_insn_reservation "alg_fmove" 4
+  (and (eq_attr "cpu" "allegrex") (eq_attr "type" "fabs,fneg,fmove"))
+  "alu")
+;; float comparisons: generic 3
+(define_insn_reservation "alg_fcmp" 4
+  (and (eq_attr "cpu" "allegrex") (eq_attr "type" "fcmp"))
+  "alu")
+;; single-precision multiplications: generic 7
+(define_insn_reservation "alg_fmul_single" 4
+  (and (eq_attr "cpu" "allegrex")
+       (and (eq_attr "type" "fmul,fmadd") (eq_attr "mode" "SF")))
+  "alu")
+;; mfc1, mtc1: generic 2
+(define_insn_reservation "alg_xfer" 3
+  (and (eq_attr "cpu" "allegrex") (eq_attr "type" "xfer"))
+  "alu")
+;; integer multiplications: generic 17
+(define_insn_reservation "alg_imul" 5
+  (and (eq_attr "cpu" "allegrex") (eq_attr "type" "imul,imadd"))
+  "alu")
